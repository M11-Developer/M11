kin_light","uniform":"sand_light","accent":"team_blue","helmet":"sand_deep","hair":"brown_dark"},"yusuf":{"name":"يوسف","gender":"m","style":"heavy","bio":"مهندس ألغام سابق تحوّل إلى حامل درع ثقيل للفريق.\nيستخدم جسده غطاءً لمن خلفه، ويصف ذلك بالعمل العادي.","skin":"skin_deep","uniform":"mid_gray","accent":"team_orange","helmet":"shadow_gray","hair":"black"},"tariq":{"name":"طارق","gender":"m","style":"nightops","bio":"عمل في وحدات العمليات الليلية قبل أن يختفي من السجلات.\nلا أحد يعرف اسمه الحقيقي، الجميع يعرف صوته.","skin":"skin_dark","uniform":"olive_dark","accent":"team_purple","helmet":"black","hair":"black"},"adam":{"name":"آدم","gender":"m","style":"medic","bio":"مسعف ميداني أنقذ أربعين جريحًا في حصار واحد.\nيحمل البندقية فقط لأن الوقت لا يسمح بالجروح.","skin":"skin_medium","uniform":"steel_blue","accent":"team_white","helmet":"light_gray","hair":"earth"},"layla":{"name":"ليلى","gender":"f","style":"scout","bio":"استطلاعية سريعة، تسبق الفريق دائمًا بثلاثين ثانية.\nتعرف كل زاوية في الخريطة قبل أن تدخلها.","skin":"skin_medium","uniform":"olive","accent":"team_green","helmet":"olive_dark","hair":"black"},"noor":{"name":"نور","gender":"f","style":"sniper","bio":"مدرّبة قنص من فريق النخبة.\nتحسب الريح بالإحساس، وتصيب من الطلقة الأولى.","skin":"skin_light","uniform":"mid_gray","accent":"team_blue","helmet":"shadow_gray","hair":"brown_dark"},"hala":{"name":"هالة","gender":"f","style":"demolition","bio":"خبيرة تفكيك متفجرات، أهدأ شخص في الفريق تحت النار.\nتمسك القنبلة كأنها كوب شاي.","skin":"skin_dark","uniform":"sand_dark","accent":"team_red","helmet":"brown_dark","hair":"black"},"sara":{"name":"سارة","gender":"f","style":"engineer","bio":"مهندسة ميدانية تبني الدفاعات في دقائق.\nتمدح المتفجرات المصنوعة يدويًا أكثر من أي بندقية.","skin":"skin_light","uniform":"olive_dark","accent":"team_yellow","helmet":"earth","hair":"brown_dark"},"mariam":{"name":"مريم","gender":"f","style":"recon","bio":"قائدة فريق الاستطلاع الجوي بالطائرات المسيّرة.\nترى الخريطة من فوق قبل أن يتنفّس العدو.","skin":"skin_deep","uniform":"steel_blue","accent":"accent_teal","helmet":"blue_shadow","hair":"black"},"faisal":{"name":"فيصل","gender":"m","style":"commander","bio":"قائد ميداني من مدرسة الصحراء؛ يخطّط للقتال كما يخطّط الشطرنجي لآخر ثلاث نقلات.\nلا يرفع صوته أبدًا، ولهذا يستمع إليه الجميع.","skin":"skin_dark","uniform":"sand_dark","accent":"team_orange","helmet":"sand_deep","hair":"black"},"zayd":{"name":"زيد","gender":"m","style":"sailor","bio":"بحّار سابق في خفر السواحل قبل أن يمسك البندقية.\nيعرف البحر أكثر مما يعرف البر، ويعرف متى ينسحب.","skin":"skin_deep","uniform":"steel_blue","accent":"team_blue","helmet":"blue_shadow","hair":"black"},"omar":{"name":"عمر","gender":"m","style":"gunner","bio":"رامي مدفع ثقيل يعرف وزن كل رصاصة في المقذوفة.\nيهدئ نفسه بعد كل اشتباك بإصلاح المدفع بنفسه.","skin":"skin_medium","uniform":"mid_gray","accent":"team_red","helmet":"shadow_gray","hair":"brown_dark"},"khalid":{"name":"خالد","gender":"m","style":"medic","bio":"مسعف ميداني ثانٍ، تدرّب في الميناء على انتشال الغرقى.\nيحمل حقيبة أثقل من رشاشته، ويعدّها الأهم.","skin":"skin_light","uniform":"olive","accent":"team_white","helmet":"light_gray","hair":"earth"},"salem":{"name":"سالم","gender":"m","style":"demolition","bio":"رجل متفجرات يحبّ الصوت العالي والخطة البسيطة.\nيقول إن الباب المغلق ليس مشكلة، بل دعوة.","skin":"skin_medium","uniform":"olive_dark","accent":"team_yellow","helmet":"olive_dark","hair":"black"},"amal":{"name":"أمل","gender":"f","style":"sailor","bio":"ضابطة سطح سفينة، تدير شؤون السفينة كما تدير الاشتباك: بالترتيب.\nتقسّم الذخيرة قبل المعركة لا بعدها.","skin":"skin_deep","uniform":"steel_blue","accent":"accent_teal","helmet":"blue_shadow","hair":"black"},"rana":{"name":"رنا","gender":"f","style":"sniper","bio":"قنّاصة تعمل من أبراج الميناء، تختار موقعها قبل أن تُفتح اللعبة.\nتحبّ الضباب لأنه يخفيها ويُظهر الأهداف.","skin":"skin_light","uniform":"sand_light","accent":"team_purple","helmet":"sand_deep","hair":"brown_dark"},"dina":{"name":"دينا","gende