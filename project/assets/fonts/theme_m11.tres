; ثيم الواجهة — يضمن رسم العربية بشكل صحيح في كل النصوص
; Cairo للأرقام واللاتينية، و Noto Sans Arabic كخط احتياطي لكل محرف لا يغطيه Cairo
; (كان الخط الاحتياطي مذكورًا في التعليق فقط وغير مربوط فعليًا بالثيم).
[gd_resource type="Theme" load_steps=6 format=3 uid="uid://m11theme0001"]

[ext_resource type="FontFile" path="res://assets/fonts/cairo_400.ttf" id="1_reg"]
[ext_resource type="FontFile" path="res://assets/fonts/cairo_700.ttf" id="2_bold"]
[ext_resource type="FontFile" path="res://assets/fonts/noto_ar_500.ttf" id="3_fall"]

[sub_resource type="FontVariation" id="FontVar_reg"]
base_font = ExtResource("1_reg")
fallbacks = Array[Font]([ExtResource("3_fall")])

[sub_resource type="FontVariation" id="FontVar_bold"]
base_font = ExtResource("2_bold")
fallbacks = Array[Font]([ExtResource("3_fall")])

[resource]
default_font = SubResource("FontVar_reg")
default_font_size = 15
Label/fonts/font = SubResource("FontVar_reg")
RichTextLabel/fonts/normal_font = SubResource("FontVar_reg")
RichTextLabel/fonts/bold_font = SubResource("FontVar_bold")
Button/fonts/font = SubResource("FontVar_bold")
Button/font_size = 15
