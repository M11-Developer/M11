; ============================================================================
; ميكا ١١ — ملف مشروع Godot 4.3+
; إعدادات القسم 2 من دفتر المشروع: 480×270 منطقيًا (لعبة بيكسل)، تكبير صحيح،
; قفل أفقي، أندرويد 8.0+ (minSdk 26 / targetSdk 35)، بلا إذن الإنترنت.
;
; للتشغيل:  Godot 4.3 → Import → اختر هذا المجلد → Run
; للتصدير:  Project ▸ Export ▸ Android (attachments/export_presets.cfg)
; ============================================================================

config_version=5

[application]

config/name="ميكا ١١"
config/description="لعبة تصويب عربية ثنائية الأبعاد للشبكة المحلية — بلا إنترنت."
config/version="2.1.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/atlases/app_icon.png"
boot_splash/image="res://assets/atlases/app_loading.png"
boot_splash/bg_color=Color(0.043, 0.051, 0.063, 1)
boot_splash/show_image=true
boot_splash/fullsize=false
boot_splash/use_filter=false
; زر الرجوع في أندرويد يُعالَج في main.gd بدل إغلاق اللعبة
config/quit_on_go_back=false

[autoload]

Config="*res://src/core/config.gd"
Save="*res://src/core/save_data.gd"
AudioBus="*res://src/core/audio_bus.gd"
NetMgr="*res://src/net/net_manager.gd"

[debug]

gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0

[display]

; ---------------------------------------------------------------------------
; إعدادات الشاشة — مضبوطة لتغطية كامل الشاشة على كل الهواتف بلا أي حواف سوداء.
; ملاحظة مهمة: window/handheld/orientation في Godot 4:
;   0 = أفقي (Landscape)   1 = عمودي (Portrait) ← كان هذا خطأً سابقًا!
;   2 = أفقي معكوس         3 = عمودي معكوس
;   4 = أفقي تلقائي (Sensor Landscape) ← نستخدمه ليتبع دوران الجهاز
; ---------------------------------------------------------------------------
window/size/viewport_width=640
window/size/viewport_height=360
; على الحاسوب: نافذة 1280×720 عند التشغيل
window/size/window_width_override=1280
window/size/window_height_override=720
; mode=canvas_items يحافظ على وضوح النصوص العربية (لا يكبّر صورة 640×360)
; aspect=expand يجعل مساحة اللعب تتمدد مع نسبة شاشة الهاتف ⇒ لا حواف سوداء
; scale_mode=fractional يضمن ملء الشاشة تمامًا على أي نسبة أبعاد
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="fractional"
window/handheld/orientation=4
window/vsync/vsync_mode=1
window/size/resizable=true
; ملء الشاشة الحقيقي على أندرويد (يُخفى شريط الحالة وأزرار النظام)
window/size/borderless=true
window/size/always_on_top=false
window/subwindows/embed_subwindows=true

[gui]

theme/custom="res://assets/fonts/theme_m11.tres"

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=false

[physics]

common/physics_ticks_per_second=60
2d/default_gravity=1500.0
2d/default_gravity_vector=Vector2(0, 1)

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.043, 0.051, 0.063, 1)
anti_aliasing/quality/msaa_2d=0
textures/default_filters/use_nearest_mipmap_filter=false
# مطلوب لتصدير أندرويد: بدونه يرفض Godot التصدير برسالة فارغة تمامًا
# (سطر في المحرّك: if (!should_import_etc2_astc()) valid = false; بلا أي رسالة)
textures/vram_compression/import_etc2_astc=true

[audio]

buses/default_bus_layout="res://assets/audio/default_bus_layout.tres"

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="pickup"
2d_physics/layer_5="projectile"
2d_physics/layer_6="vehicle"
2d_physics/layer_7="destructible"
2d_physics/layer_8="trigger"

[network]

limits/debugger/max_queued_messages=2048

; ----------------------------------------------------------------------------
; خريطة الإدخال — مطابقة تمامًا لمفاتيح نسخة الويب (web/src/core/input.js)
; ----------------------------------------------------------------------------

