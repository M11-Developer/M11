# ============================================================================
# ثوابت أنواع البلاط (Tile Types)
# ملف مشترك لا يعتمد على أي ملف آخر — الغرض منه كسر «دورة التحليل» بين
# GameWorld و Actor/Projectile، لأن Godot لا يستطيع تحليل صنفين يعتمدان
# على بعضهما. القيم هنا هي المصدر الوحيد للحقيقة.
# ============================================================================
class_name M11Tiles
extends RefCounted

const EMPTY := 0      # فراغ
const SOLID := 1      # أرض صمّاء
const TOP := 2        # سطح (قابل للمشي عليه)
const PLATFORM := 3   # منصّة (تمرّ من تحتها)
const CRATE := 4      # صندوق قابل للتدمير
const GLASS := 5      # زجاج
const SANDBAG := 6    # أكياس رمل
const LADDER := 7     # سلّم
const WATER := 8      # ماء (سباحة/غرق)
const HAZARD := 9     # خطر (سياج كهرباء/نار)
const BACK := 10      # خلفية (لا تصادم)
const GIRDER := 13    # جسر معدني
